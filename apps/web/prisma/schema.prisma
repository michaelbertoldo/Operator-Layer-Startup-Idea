generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum ReservationState {
  HELD     // budget committed, outcome pending
  SETTLED  // spend went through, hold becomes permanent spend
  RELEASED // rejected/failed, budget given back
}

model Company {
  id              String           @id
  name            String
  environment     String
  paymentExecutor String
  frozenAt       DateTime?
  freezeReason   String?
  createdAt       DateTime         @default(now())
  users           User[]
  agents          Agent[]
  vendors         Vendor[]
  policies        Policy[]
  paymentRequests PaymentRequest[]
  auditLogs       AuditLog[]
  anomalyEvents   SpendAnomalyEvent[]
  provisionedCredentials ProvisionedCredential[]
}

model User {
  id        String   @id
  companyId String
  name      String
  email     String   @unique
  role      String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
}

model Agent {
  id                    String           @id
  companyId             String
  policyId              String?
  name                  String
  status                String
  ownerName             String
  weeklyBudgetCents     Int
  spentThisWeekCents    Int
  approvedVendorCount   Int
  riskLevel             String
  frozenAt              DateTime?
  freezeReason          String?
  createdAt             DateTime         @default(now())
  company               Company          @relation(fields: [companyId], references: [id])
  policy                Policy?          @relation(fields: [policyId], references: [id])
  paymentRequests       PaymentRequest[]
  budgetPeriods         AgentBudgetPeriod[]
  idempotencyKeys       IdempotencyKey[]
  apiKeys               AgentApiKey[]
  anomalyEvents         SpendAnomalyEvent[]
}

model Vendor {
  id                  String           @id
  companyId           String
  name                String
  category            String
  status              String
  requestCount        Int
  simulatedSpendCents Int
  createdAt           DateTime         @default(now())
  company             Company          @relation(fields: [companyId], references: [id])
  paymentRequests     PaymentRequest[]
}

model Policy {
  id                             String   @id
  companyId                      String
  name                           String
  maxTransactionCents            Int
  weeklyBudgetCents              Int
  approvalThresholdCents         Int
  allowedCategories              String
  sensitiveCategories            String?
  requireApprovalForNewVendor    Boolean
  createdAt                      DateTime @default(now())
  company                        Company  @relation(fields: [companyId], references: [id])
  agents                         Agent[]
}

model PaymentRequest {
  id             String     @id
  companyId      String
  agentId        String
  vendorId       String
  category       String
  amountCents    Int
  status         String
  policyDecision String
  riskLevel      String
  riskScore      Int        @default(0)
  policySnapshot String?    // snapshot of policy at request time
  fakeTransactionId String?
  fakeRail       String?
  fakeAsset      String?
  executedAt     DateTime?
  createdAt      DateTime   @default(now())
  company        Company    @relation(fields: [companyId], references: [id])
  agent          Agent      @relation(fields: [agentId], references: [id])
  vendor         Vendor     @relation(fields: [vendorId], references: [id])
  auditLogs      AuditLog[]
  reservation    SpendReservation?
}

model AuditLog {
  id               String          @id
  companyId        String
  paymentRequestId String?
  actor            String
  action           String
  target           String
  detail           String
  prevHash         String?
  hash             String            @default("")
  createdAt        DateTime        @default(now())
  company          Company         @relation(fields: [companyId], references: [id])
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id])
}

model AgentBudgetPeriod {
  id                String             @id
  agentId           String
  periodKey         String             // e.g. "2026-W27"
  limitCents        Int                // weekly budget limit
  heldCents         Int                @default(0)  // single source of truth for committed budget
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  agent             Agent              @relation(fields: [agentId], references: [id])
  reservations      SpendReservation[]

  @@unique([agentId, periodKey])
  @@index([periodKey])
}

model SpendReservation {
  id               String             @id
  periodId         String
  paymentRequestId String             @unique
  amountCents      Int
  state            ReservationState    @default(HELD)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  period           AgentBudgetPeriod   @relation(fields: [periodId], references: [id])
  paymentRequest   PaymentRequest      @relation(fields: [paymentRequestId], references: [id])

  @@index([periodId, state])
}

model IdempotencyKey {
  id               String          @id
  agentId          String
  key              String
  paymentRequestId String
  createdAt        DateTime        @default(now())
  agent            Agent           @relation(fields: [agentId], references: [id])

  @@unique([agentId, key])
}

model AgentApiKey {
  id              String    @id
  agentId         String
  keyHash         String    @unique  // sha256 of the presented token
  label           String?
  revokedAt       DateTime? // non-null = instant kill switch
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?
  agent           Agent     @relation(fields: [agentId], references: [id])

  @@index([agentId])
}

model SpendAnomalyEvent {
  id        String   @id
  companyId String
  agentId   String
  kind      String
  detail    String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  agent     Agent    @relation(fields: [agentId], references: [id])

  @@index([companyId, createdAt])
  @@index([agentId, createdAt])
  @@index([kind])
}

/// Provisioned third-party API credentials, stored encrypted.
/// Created through OperatorLayer Connect's guided provisioning flow.
model ProvisionedCredential {
  id              String    @id
  companyId       String
  vendorId        String    // matches Vendor.id
  provider        String    // "railway", "anthropic", etc.
  envVarName      String    // "RAILWAY_TOKEN", "ANTHROPIC_API_KEY"
  encryptedValue  String    // AES-256-GCM encrypted secret
  encryptionIv    String    // Initialization vector for AES-GCM
  scopes          String?   // JSON array of granted scopes
  provisionedBy   String    // agentId or userId who approved provisioning
  provisionedAt   DateTime  @default(now())
  revokedAt       DateTime?
  lastUsedAt      DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, vendorId])
  @@index([companyId, provider])
  @@index([provider])
}
